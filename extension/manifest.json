{
  "manifest_version": 3,
  "name": "NoReels — Bloquea Reels y Shorts",
  "version": "1.0.0",
  "description": "Bloquea Instagram Reels y YouTube Shorts. Usa las apps sin contenido corto adictivo.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content-youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-instagram.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoReels"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
